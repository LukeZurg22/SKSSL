<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        
        <!--Compiler Generator-->
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <!--<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>-->
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="LibVLCSharp" Version="3.10.1" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0.0" PrivateAssets="all"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="PolySharp" Version="*">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Tomlyn" Version="2.4.1" />
        <PackageReference Include="YamlDotNet" Version="18.0.0" />
    </ItemGroup>

    <!-- This packs the generator DLL into the right folder -->
    <!--<ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="true" />
    </ItemGroup>-->

</Project>
