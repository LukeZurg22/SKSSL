<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <NoWarn>$(NoWarn);SYSLIB0011;CS0108;CS8618;CS8619;NU5100</NoWarn>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SKSSL</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>SKSSL</PackageId>
        <Version>1.0.0</Version> <!--1.8.2 (Namespaces, Prototype / Entity Refactor)--> <!--Version Auto-Changed-->
        <Authors>LukeZurg22</Authors>
        <Description>Shared general game engine built on Monogame and GumUI.</Description>
        <PackageTags>logging, ecs, yaml, parsing</PackageTags>
        <RepositoryUrl>https://github.com/LukeZurg22/SKSSL</RepositoryUrl>
        <IncludeBuildOutput>true</IncludeBuildOutput> <!--For generated classes.-->

        <!--For Packaging-->
        <ExcludeTestAssets>true</ExcludeTestAssets>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateLibraryLayout>true</GenerateLibraryLayout>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <!--The Ones That Flow-->
        <PackageReference Include="FlatRedBall.GumCommon" Version="2026.5.31.1" PrivateAssets="none"/>
        <PackageReference Include="Gum.MonoGame" Version="2026.5.31.1" PrivateAssets="none"/>
        <PackageReference Include="MemoryPack" Version="1.21.4" PrivateAssets="none"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" PrivateAssets="none"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" PrivateAssets="none"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" PrivateAssets="none"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="RandN" Version="0.5.0" PrivateAssets="none"/>
        <PackageReference Include="Fluent.Net" Version="1.0.63" PrivateAssets="none"/>
        <PackageReference Include="ImGui.NET" Version="1.91.6.1" PrivateAssets="none"/>
        <PackageReference Include="ImGUI.NET.ToolBox" Version="0.1.1" PrivateAssets="none"/>
        <PackageReference Include="YamlDotNet" Version="18.0.0"/>

        <!--Private Ones-->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="All"/>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" PrivateAssets="All"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Testing.Platform" Version="1.7.3" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.TestPlatform.TestHost" Version="17.14.1" PrivateAssets="all"/>
        <PackageReference Include="Tomlyn" Version="2.4.1"/>
    </ItemGroup>

    <!--Exclude Testhost Stuff-->
    <ItemGroup>
        <Content Update="testhost.exe;testhost*.exe;testhost*.dll;testhost*.json"
                 CopyToOutputDirectory="Never"
                 CopyToPublishDirectory="Never"/>
    </ItemGroup>

    <PropertyGroup>
        <!--<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <!-- Ignore unwanted built-in generators -->
    <ItemGroup>
        <CompilerGeneratedFilesToExclude Include="**/*RegexGenerator*"/>
        <CompilerGeneratedFilesToExclude Include="**/*Regex.g.cs"/>
        <CompilerGeneratedFilesToExclude Include="**/*Yaml*"/>
        <CompilerGeneratedFilesToExclude Include="**/*VYaml*"/>
        <CompilerGeneratedFilesToExclude Include="**/*System*"/>
        <CompilerGeneratedFilesToExclude Include="**/*YAMLSerializer*"/>
        <CompilerGeneratedFilesToExclude Include="**/*BaseYaml*"/>
    </ItemGroup>

    <ItemGroup> <!--Reference to Source Generator(s)-->
        <ProjectReference Include="..\SKSSL.Generator\SKSSL.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Explicitly pack the generator DLL (adjust path if needed) -->
        <None Include="..\SKSSL.Generator\bin\$(Configuration)\netstandard2.0\SKSSL.Generator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="true"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Networking\"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Textures\TextureLoader.MaterialRegistry.cs">
            <DependentUpon>TextureLoader.cs</DependentUpon>
        </Compile>
        <Compile Update="Textures\TextureLoader.HardcodedTextures.cs">
            <DependentUpon>TextureLoader.cs</DependentUpon>
        </Compile>
        <Compile Update="Extensions\EntityExtensions_Clone.cs">
            <DependentUpon>EntityExtensions.cs</DependentUpon>
        </Compile>
        <Compile Update="Extensions\EntityExtensions_Components.cs">
            <DependentUpon>EntityExtensions.cs</DependentUpon>
        </Compile>
        <Compile Update="Extensions\EntityExtensions_Queries.cs">
            <DependentUpon>EntityExtensions.cs</DependentUpon>
        </Compile>
        <Compile Update="ECS\EntitySystem_Interfaces.cs">
            <DependentUpon>EntitySystem.cs</DependentUpon>
        </Compile>
        <Compile Update="ECS\RegisterSystemAttribute.cs">
            <DependentUpon>EntitySystem.cs</DependentUpon>
        </Compile>
        <Compile Update="Textures\TextureLoader.IconRegistry.cs">
          <DependentUpon>TextureLoader.cs</DependentUpon>
        </Compile>
        <Compile Update="Textures\TextureLoader.XNAContent.cs">
          <DependentUpon>TextureLoader.cs</DependentUpon>
        </Compile>
        <Compile Update="ECS\ECSRegistries\ECSRegistry.Entity.cs">
          <DependentUpon>ECSRegistry.cs</DependentUpon>
        </Compile>
        <Compile Update="ECS\ECSRegistries\ECSRegistry.RawPrototype.cs">
          <DependentUpon>ECSRegistry.cs</DependentUpon>
        </Compile>
    </ItemGroup>

