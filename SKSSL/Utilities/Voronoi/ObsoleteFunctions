            pass.Apply();
            _graphicsDevice.DrawUserPrimitives(
                PrimitiveType.TriangleList,
                vertices,
                0,
                1);
        }
    }

    // ReSharper disable once UnusedMember.Local
    [Obsolete]
    private void DrawBoundaryEdges(Color color, float thickness)
    {
        DrawLine(
            new Point(0, 0),
            new Point(_width, 0),
            color,
            thickness);

        DrawLine(
            new Point(_width, 0),
            new Point(_width, _height),
            color,
            thickness);

        DrawLine(
            new Point(_width, _height),
            new Point(0, _height),
            color,
            thickness);

        DrawLine(
            new Point(0, _height),
            new Point(0, 0),
            color,
            thickness);
    }